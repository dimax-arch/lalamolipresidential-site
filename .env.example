# Copia este archivo a .env y reemplaza con tus credenciales de Supabase.
# Project Settings → API en el dashboard de Supabase.
# La clave anon es pública por diseño (RLS protege los datos).

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# Spotify — panel "Ahora Suena" (estilo Discord).
# Client ID de developer.spotify.com/dashboard. Es público por diseño
# (OAuth PKCE en el cliente, sin client_secret). Déjalo vacío para ocultar
# la función. Redirect URI a registrar: <tu-dominio>/spotify-callback.html
VITE_SPOTIFY_CLIENT_ID=TU_SPOTIFY_CLIENT_ID

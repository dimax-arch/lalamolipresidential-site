# Copia este archivo a .env y reemplaza con tus credenciales de Supabase.
# Project Settings → API en el dashboard de Supabase.
# La clave anon es pública por diseño (RLS protege los datos).

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# Spotify — panel "Ahora Suena" (estilo Discord).
# Client ID de developer.spotify.com/dashboard. Es público por diseño
# (OAuth PKCE en el cliente, sin client_secret). Déjalo vacío para ocultar
# el botón "Connect Spotify" del panel. Redirect URI a registrar:
# <tu-dominio>/spotify-callback.html
VITE_SPOTIFY_CLIENT_ID=TU_SPOTIFY_CLIENT_ID

# ── "Entrar con Spotify" (login unificado con el panel now-playing) ──
# NO requiere variables nuevas en el cliente. Configuración (una sola vez):
#  1. Supabase → Authentication → Providers → Spotify: enable + Client ID/Secret.
#  2. Spotify Dashboard → Redirect URIs: añade el callback de Supabase
#     https://<PROYECTO>.supabase.co/auth/v1/callback
#  3. Supabase → Authentication → URL Configuration → Redirect URLs:
#     añade https://lalamoliypipe.com/ y http://127.0.0.1:5173/
#  4. Edge Function spotify-refresh (refresca el token del proveedor):
#     supabase secrets set SPOTIFY_CLIENT_ID=... SPOTIFY_CLIENT_SECRET=...
#     supabase functions deploy spotify-refresh
#  5. Verifica que ambas cuentas tengan el email confirmado (vinculación
#     automática por correo: conserva el rol y los datos existentes).
